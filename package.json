{
  "name": "@jalexw/mould",
  "version": "0.1.6",
  "private": false,
  "description": "Generate sample projects and insert code snippets from your configurable templates collection",
  "repository": {
    "url": "https://github.com/jalexw/mould.git",
    "type": "git"
  },
  "dependencies": {
    "commander": "14.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "bun-types": "1.3.14",
    "tsc-alias": "1.8.16"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun run src/bin/mould.ts",
    "build:typescript": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "build:mouldconfig-openapi": "bun run ./src/build-openapi/mouldconfig.ts",
    "build": "bun run build:typescript && bun run build:mouldconfig-openapi",
    "postbuild": "bun run cleanup",
    "cleanup:compiled_tests_in_dist_directory": "find ./dist -type f \\( -name \"*.test.js\" -o -name \"*.test.js.map\" -o -name \"*.test.d.ts\" \\) -delete",
    "cleanup:delete_test_directories": "find ./dist -type d -name '__test__' -prune -exec rm -rf {} +",
    "cleanup:delete_dist_build_scripts": "rm -rf ./dist/build-openapi",
    "cleanup": "bun run cleanup:compiled_tests_in_dist_directory && bun run cleanup:delete_test_directories && bun run cleanup:delete_dist_build_scripts",
    "execute": "NODE_ENV=production node dist/bin/mould.js",
    "test": "bun test && rm -rf ./tmp"
  },
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "bin": {
    "mould": "dist/bin/mould.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
